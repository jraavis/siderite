{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siderite.dev/schemas/cli-report-v1.json",
  "title": "Siderite CLI report envelope, version 1",
  "description": "Every structured CLI report. New fields are additive within schema_version 1, so consumers must ignore unknown properties.",
  "type": "object",
  "required": ["schema_version", "command", "ok", "data", "diagnostics"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "data": {
      "description": "The command's report; null when the command failed before producing one (ok is then false).",
      "type": ["object", "null"]
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diagnostic" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "data": { "type": "null" } },
        "required": ["data"]
      },
      "then": { "properties": { "ok": { "const": false } } }
    },
    {
      "if": { "properties": { "command": { "const": "check" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/CheckSummary" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "routes" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/RoutesData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "showmigrations" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [
              { "$ref": "#/$defs/MigrationStatusData" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "setup" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/DoctorData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "doctor" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/DoctorData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "docs search" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/DocsData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "verify" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/VerifyData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "snapshot" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/Snapshot" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "ai dump-context" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/AiContext" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "commands" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/CommandList" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "models" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/ModelsData" }, { "type": "null" }]
          }
        }
      }
    }
  ],
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[EWI][0-9]{3}$"
        },
        "severity": {
          "description": "info is reserved and never fails a report.",
          "enum": ["info", "warning", "error"]
        },
        "message": { "type": "string" },
        "location": { "type": "string" },
        "hint": { "type": "string" }
      }
    },
    "MigrationStatusData": {
      "type": "object",
      "required": ["alias", "source", "migrations", "applied", "pending"],
      "properties": {
        "alias": { "type": ["string", "null"] },
        "source": { "enum": ["flag", "settings", "environment"] },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "applied"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "applied": { "type": "boolean" }
            }
          }
        },
        "applied": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "DoctorData": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "detail"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["ok", "info", "warning", "error"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "DocsData": {
      "type": "object",
      "required": [
        "docs_version",
        "index_format",
        "installed",
        "query",
        "total",
        "results"
      ],
      "properties": {
        "docs_version": { "type": "string", "minLength": 1 },
        "index_format": { "const": 1 },
        "installed": { "type": "array", "items": { "type": "string" } },
        "query": { "type": "string" },
        "total": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "title",
              "path",
              "line",
              "source_url",
              "features",
              "compiled",
              "score",
              "excerpt",
              "text",
              "truncated"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["guide", "example"] },
              "title": { "type": "string" },
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "source_url": { "type": "string" },
              "features": { "type": "array", "items": { "type": "string" } },
              "compiled": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0 },
              "excerpt": { "type": "array", "items": { "type": "string" } },
              "text": { "type": "string" },
              "truncated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "VerifyData": {
      "type": "object",
      "required": [
        "profile",
        "diagnostic_format",
        "test_results",
        "steps"
      ],
      "properties": {
        "profile": { "enum": ["offline", "live"] },
        "diagnostic_format": { "const": 1 },
        "test_results": { "const": "aggregate" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command",
              "status",
              "duration_ms",
              "exit_code",
              "output",
              "diagnostics",
              "omitted_diagnostics"
            ],
            "properties": {
              "name": {
                "enum": ["fmt", "lint", "build", "test", "check"]
              },
              "command": { "type": "string" },
              "status": { "enum": ["passed", "failed", "skipped"] },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "exit_code": { "type": ["integer", "null"] },
              "output": { "type": ["string", "null"] },
              "diagnostics": {
                "type": "array",
                "maxItems": 50,
                "items": { "$ref": "#/$defs/CompilerDiagnostic" }
              },
              "omitted_diagnostics": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "CompilerDiagnostic": {
      "type": "object",
      "required": ["level", "code", "message", "spans", "rendered"],
      "properties": {
        "level": { "type": "string" },
        "code": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "rendered": { "type": ["string", "null"] },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "line_start",
              "line_end",
              "column_start",
              "column_end",
              "primary",
              "label"
            ],
            "properties": {
              "file": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "column_start": { "type": "integer", "minimum": 1 },
              "column_end": { "type": "integer", "minimum": 1 },
              "primary": { "type": "boolean" },
              "label": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "required": [
        "format",
        "format_version",
        "framework",
        "app",
        "features",
        "databases",
        "models",
        "routes",
        "openapi",
        "completeness"
      ],
      "properties": {
        "format": { "const": "siderite-snapshot" },
        "format_version": { "const": 1 },
        "framework": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "app": {
          "type": "object",
          "required": ["title", "version", "description"],
          "properties": {
            "title": { "type": "string" },
            "version": { "type": "string" },
            "description": { "type": ["string", "null"] }
          }
        },
        "features": { "type": "array", "items": { "type": "string" } },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alias", "backend"],
            "properties": {
              "alias": { "type": "string" },
              "backend": {
                "enum": [
                  "sqlite",
                  "postgres",
                  "mysql",
                  "mongodb",
                  "redis",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModelReport" }
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/RouteReport" }
        },
        "openapi": { "type": ["object", "null"] },
        "completeness": {
          "type": "object",
          "required": ["models", "routes", "openapi"],
          "additionalProperties": { "$ref": "#/$defs/Section" }
        }
      }
    },
    "AiContext": {
      "type": "object",
      "required": ["snapshot", "source", "migrations"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/Snapshot" },
        "source": {
          "type": "object",
          "required": ["binary", "built_unix"],
          "properties": {
            "binary": { "type": ["string", "null"] },
            "built_unix": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "migrations": {
          "type": "object",
          "required": ["state", "detail", "status"],
          "properties": {
            "state": { "enum": ["unknown", "read", "failed"] },
            "detail": { "type": ["string", "null"] },
            "status": {
              "anyOf": [
                { "$ref": "#/$defs/MigrationStatusData" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "Section": {
      "type": "object",
      "required": ["complete", "total", "included", "reason"],
      "properties": {
        "complete": { "type": "boolean" },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "included": { "type": "integer", "minimum": 0 },
        "reason": { "type": ["string", "null"] }
      }
    },
    "CommandList": {
      "type": "object",
      "required": ["version", "siderite", "commands"],
      "properties": {
        "version": { "const": 1 },
        "siderite": { "type": "string" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "group",
              "usage",
              "summary",
              "runner",
              "needs",
              "mutates",
              "live",
              "formats"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "group": { "enum": ["app", "migrations", "ai", "cargo", "tool"] },
              "usage": { "type": "string" },
              "summary": { "type": "string" },
              "runner": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "enum": ["tool", "app", "app_or_standalone", "cargo"]
                  }
                }
              },
              "needs": { "enum": ["nothing", "package", "app"] },
              "mutates": {
                "type": "array",
                "items": {
                  "enum": [
                    "project_files",
                    "output_file",
                    "database",
                    "build_artifacts",
                    "runs_code",
                    "toolchain"
                  ]
                }
              },
              "live": { "enum": ["never", "opt_in", "always"] },
              "formats": {
                "type": "array",
                "items": { "enum": ["text", "json", "markdown", "document"] }
              }
            }
          }
        }
      }
    },
    "CheckSummary": {
      "type": "object",
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "RoutesData": {
      "type": "object",
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/RouteReport" }
        }
      }
    },
    "RouteReport": {
      "type": "object",
      "required": ["method", "path", "operation_id", "tags", "summary"],
      "properties": {
        "method": { "type": "string" },
        "path": { "type": "string" },
        "operation_id": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": ["string", "null"] }
      }
    },
    "ModelsData": {
      "type": "object",
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModelReport" }
        }
      }
    },
    "ModelReport": {
      "type": "object",
      "required": ["name", "table", "managed", "fields"],
      "properties": {
        "name": { "type": "string" },
        "table": { "type": "string" },
        "managed": { "type": "boolean" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldReport" }
        }
      }
    },
    "FieldReport": {
      "type": "object",
      "required": ["name", "column", "type", "nullable", "pk"],
      "properties": {
        "name": { "type": "string" },
        "column": { "type": "string" },
        "type": { "type": "string" },
        "nullable": { "type": "boolean" },
        "pk": { "type": "boolean" }
      }
    }
  }
}
