{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siderite.dev/schemas/cli-report-v1.json",
  "title": "Siderite CLI report envelope, version 1",
  "description": "Every structured CLI report. New fields are additive within schema_version 1, so consumers must ignore unknown properties.",
  "type": "object",
  "required": ["schema_version", "command", "ok", "data", "diagnostics"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "data": {
      "description": "The command's report; null when the command failed before producing one (ok is then false).",
      "type": ["object", "null"]
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diagnostic" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "data": { "type": "null" } },
        "required": ["data"]
      },
      "then": { "properties": { "ok": { "const": false } } }
    },
    {
      "if": { "properties": { "command": { "const": "check" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/CheckSummary" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "routes" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/RoutesData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "showmigrations" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [
              { "$ref": "#/$defs/MigrationStatusData" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "doctor" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/DoctorData" }, { "type": "null" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "models" } } },
      "then": {
        "properties": {
          "data": {
            "anyOf": [{ "$ref": "#/$defs/ModelsData" }, { "type": "null" }]
          }
        }
      }
    }
  ],
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[EWI][0-9]{3}$"
        },
        "severity": {
          "description": "info is reserved and never fails a report.",
          "enum": ["info", "warning", "error"]
        },
        "message": { "type": "string" },
        "location": { "type": "string" },
        "hint": { "type": "string" }
      }
    },
    "MigrationStatusData": {
      "type": "object",
      "required": ["alias", "source", "migrations", "applied", "pending"],
      "properties": {
        "alias": { "type": ["string", "null"] },
        "source": { "enum": ["flag", "settings", "environment"] },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "applied"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "applied": { "type": "boolean" }
            }
          }
        },
        "applied": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "DoctorData": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "detail"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["ok", "info", "warning", "error"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "CheckSummary": {
      "type": "object",
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "RoutesData": {
      "type": "object",
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/RouteReport" }
        }
      }
    },
    "RouteReport": {
      "type": "object",
      "required": ["method", "path", "operation_id", "tags", "summary"],
      "properties": {
        "method": { "type": "string" },
        "path": { "type": "string" },
        "operation_id": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": ["string", "null"] }
      }
    },
    "ModelsData": {
      "type": "object",
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ModelReport" }
        }
      }
    },
    "ModelReport": {
      "type": "object",
      "required": ["name", "table", "managed", "fields"],
      "properties": {
        "name": { "type": "string" },
        "table": { "type": "string" },
        "managed": { "type": "boolean" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/FieldReport" }
        }
      }
    },
    "FieldReport": {
      "type": "object",
      "required": ["name", "column", "type", "nullable", "pk"],
      "properties": {
        "name": { "type": "string" },
        "column": { "type": "string" },
        "type": { "type": "string" },
        "nullable": { "type": "boolean" },
        "pk": { "type": "boolean" }
      }
    }
  }
}
